{
    "openapi": "3.0.0",
    "info": {
        "title": "Laravel ai rag api v1",
        "description": "API для ai rag project",
        "contact": {
            "email": "test@example.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Local Development Server"
        }
    ],
    "paths": {
        "/api/v1/chat": {
            "post": {
                "tags": [
                    "Chat"
                ],
                "summary": "Задать вопрос AI-ассистенту (RAG)",
                "description": "Принимает вопрос пользователя, ищет наиболее релевантные фрагменты текста в векторной базе данных (pgvector) и генерирует ответ через LLM, опираясь исключительно на найденный корпоративный контекст.",
                "operationId": "74f81ad1246fab0bcd02bd9414843fde",
                "requestBody": {
                    "description": "Данные запроса",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "question"
                                ],
                                "properties": {
                                    "question": {
                                        "description": "Текст вопроса пользователя",
                                        "type": "string",
                                        "example": "Сколько дней отпуска я могу взять минимум за один раз?",
                                        "maxLength": 1000,
                                        "minLength": 3
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успешный ответ от нейросети",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "answer": {
                                            "description": "Сгенерированный ответ ИИ на основе базы знаний",
                                            "type": "string",
                                            "example": "Согласно регламенту, отпуск можно дробить, но одна из частей должна быть не менее 14 дней."
                                        },
                                        "sourceIds": {
                                            "description": "Массив ID документов (чанков), которые использовались в качестве контекста для формирования ответа (полезно для вывода сносок в UI)",
                                            "type": "array",
                                            "items": {
                                                "type": "integer"
                                            },
                                            "example": [
                                                2,
                                                5
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации (пустой или слишком короткий вопрос)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "example": "http://localhost:8080/errors/validation-error"
                                        },
                                        "title": {
                                            "type": "string",
                                            "example": "Validation Error"
                                        },
                                        "status": {
                                            "type": "integer",
                                            "example": 422
                                        },
                                        "detail": {
                                            "type": "string",
                                            "example": "Произошла одна или несколько ошибок проверки."
                                        },
                                        "instance": {
                                            "type": "string",
                                            "example": "/api/v1/chat"
                                        },
                                        "errors": {
                                            "description": "Список ошибок валидации",
                                            "type": "object",
                                            "example": {
                                                "question": [
                                                    "Вопрос должен содержать не менее 3 символов."
                                                ]
                                            },
                                            "additionalProperties": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/documents/ingest": {
            "post": {
                "tags": [
                    "Documents"
                ],
                "summary": "Загрузка текста для векторизации",
                "description": "Принимает текст документа, разбивает его на смысловые части (абзацы) и ставит в очередь на получение эмбеддингов (векторизацию) через AI (Ollama).",
                "operationId": "ba99b930f624240aa83e36f777b28e18",
                "requestBody": {
                    "description": "Данные документа в формате JSON",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "content"
                                ],
                                "properties": {
                                    "title": {
                                        "description": "Заголовок документа",
                                        "type": "string",
                                        "example": "Основы Laravel AI"
                                    },
                                    "content": {
                                        "description": "Текст документа. Для корректного разделения на чанки используйте двойной перенос строки (\\n\\n).",
                                        "type": "string",
                                        "example": "Первый абзац про Laravel.\n\nВторой абзац про AI RAG."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Документ успешно принят, разбит на части и отправлен в очередь.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Документ успешно разбит на части и добавлен в очередь на векторизацию."
                                        },
                                        "processedCount": {
                                            "description": "Количество созданных чанков (задач в очереди)",
                                            "type": "integer",
                                            "example": 2
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации (например, не передан контент)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "example": "http://localhost:8080/errors/validation-error"
                                        },
                                        "title": {
                                            "type": "string",
                                            "example": "Validation Error"
                                        },
                                        "status": {
                                            "type": "integer",
                                            "example": 422
                                        },
                                        "detail": {
                                            "type": "string",
                                            "example": "Произошла одна или несколько ошибок проверки."
                                        },
                                        "instance": {
                                            "type": "string",
                                            "example": "/api/v1/documents/ingest"
                                        },
                                        "errors": {
                                            "description": "Список ошибок валидации",
                                            "type": "object",
                                            "example": {
                                                "content": [
                                                    "Поле content обязательно для заполнения."
                                                ]
                                            },
                                            "additionalProperties": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Chat",
            "description": "Chat"
        },
        {
            "name": "Documents",
            "description": "Documents"
        }
    ]
}